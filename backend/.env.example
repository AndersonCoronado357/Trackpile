# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development

# 0 = el sistema operativo asigna un puerto libre automaticamente.
PORT=0
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD="cambia-esto"
DB_NAME=trackpile
DB_POOL=10

# Direccion publica. Detras de un proxy la peticion llega como localhost, asi
# que los enlaces y la vuelta de Google salen mal sin esto.
ORIGIN=

# Sesion: firma los JWT de la cookie httpOnly. Usa un valor largo y aleatorio.
AUTH_SECRET=cambia-esto-por-algo-largo-y-aleatorio
AUTH_DAYS=30
BCRYPT_ROUNDS=12
ALLOW_SIGNUP=true

# Correos que pueden abrir cuenta, separados por coma. Vacio = cualquiera.
# En internet abierto esto es lo que evita que se llene de desconocidos.
SIGNUP_ALLOWLIST=

# Acceso con Google. La URI de vuelta que hay que registrar en la consola es
# <ORIGIN>/auth/google/callback. Vacio = el boton avisa de que falta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
