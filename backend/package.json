{
  "name": "trackpile-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de Trackpile sobre MySQL",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
